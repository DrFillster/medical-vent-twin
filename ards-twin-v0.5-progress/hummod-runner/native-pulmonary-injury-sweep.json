{
  "schema": "vent-hummod-native-sweep/v1",
  "id": "pulmonary-injury-mechanism-sweep-001",
  "purpose": "Engineering sensitivity sweep to identify which native HumMod pulmonary mechanisms materially change gas exchange and systemic physiology before any Berlin ARDS calibration.",
  "clinicalValidation": false,
  "baseline": {
    "description": "Native HumMod with explicit mechanical ventilation and no pulmonary injury perturbation.",
    "assignments": {
      "Ventilator.Switch": 1,
      "Ventilator.Rate": 16,
      "Ventilator.TidalVolume": 450
    }
  },
  "cases": [
    {
      "id": "water-250",
      "mechanism": "excess-lung-water",
      "assignments": {
        "Ventilator.Switch": 1,
        "Ventilator.Rate": 16,
        "Ventilator.TidalVolume": 450,
        "ExcessLungWater.Volume": 250
      }
    },
    {
      "id": "pleural-0-bilateral",
      "mechanism": "reduced-lung-inflation-and-alveolar-shunt",
      "assignments": {
        "Ventilator.Switch": 1,
        "Ventilator.Rate": 16,
        "Ventilator.TidalVolume": 450,
        "RightHemithorax.NormalPressure": 0,
        "LeftHemithorax.NormalPressure": 0
      }
    },
    {
      "id": "membrane-area-40",
      "mechanism": "reduced-pulmonary-membrane-area",
      "assignments": {
        "Ventilator.Switch": 1,
        "Ventilator.Rate": 16,
        "Ventilator.TidalVolume": 450,
        "PulmonaryMembrane.TotalArea": 40
      }
    },
    {
      "id": "basic-shunt-1000",
      "mechanism": "increased-basic-right-left-shunt",
      "assignments": {
        "Ventilator.Switch": 1,
        "Ventilator.Rate": 16,
        "Ventilator.TidalVolume": 450,
        "LungBloodFlow.BasicR-LShunt": 1000
      }
    },
    {
      "id": "combined-injury-a",
      "mechanism": "combined-exploratory-pulmonary-injury",
      "assignments": {
        "Ventilator.Switch": 1,
        "Ventilator.Rate": 16,
        "Ventilator.TidalVolume": 450,
        "ExcessLungWater.Volume": 250,
        "RightHemithorax.NormalPressure": -2,
        "LeftHemithorax.NormalPressure": -2,
        "PulmonaryMembrane.TotalArea": 60,
        "LungBloodFlow.BasicR-LShunt": 500
      }
    }
  ],
